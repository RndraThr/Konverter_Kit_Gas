APP_ENV=production
APP_ADDR=:8080
APP_BASE_URL=https://staging.example.com
DATABASE_URL=postgres://konkit:CHANGE_ME@postgres:5432/konkit?sslmode=disable
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
SESSION_COOKIE_SECURE=true
STORAGE_PATH=/app/storage
STORAGE_BACKEND=gdrive
# gdrive uses OAuth2 user-delegated auth (not a Service Account — Service
# Accounts have no storage quota of their own on a personal Google account
# and cannot upload files anywhere). Generate GDRIVE_OAUTH_TOKEN_JSON and
# GDRIVE_ROOT_FOLDER_ID once, locally, with: go run ./cmd/gdrive-oauth-setup
# -client-id=... -client-secret=... — see README.md's Docker section.
GDRIVE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GDRIVE_OAUTH_CLIENT_SECRET=CHANGE_ME
GDRIVE_OAUTH_TOKEN_JSON=/run/secrets/gdrive-oauth-token.json
GDRIVE_ROOT_FOLDER_ID=CHANGE_ME
POSTGRES_USER=konkit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=konkit
