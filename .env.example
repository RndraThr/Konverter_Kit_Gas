APP_ENV=local
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL=12h
STORAGE_PATH=./storage

# STORAGE_BACKEND selects where uploaded media is stored: "local" (default,
# uses STORAGE_PATH above) or "gdrive". WARNING: the gdrive backend is not
# yet safe for production use with the existing Pendistribusian photo
# uploads — GoogleDriveStorage only remembers uploaded file IDs in memory,
# so Open/Delete break after any server restart, and uploads are not yet
# organized into per-kabupaten folders by that caller. Do not enable gdrive
# until the activity-documentation feature that resolves this ships.
STORAGE_BACKEND=local
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_ROOT_FOLDER_ID=
