# ============================================================
# Kontrak variabel operasional untuk Docker Compose
# ============================================================
# Salin file ini menjadi .env.compose (jangan .env.staging),
# lalu isi semua nilai yang bertanda CHANGE_ME.
#
# Cara pakai:
#   docker compose -f docker-compose.yml -f docker-compose.gdrive.yml \
#     --env-file .env.compose up -d --build
#
# File contoh ini tidak memuat rahasia nyata. Simpan .env.compose hanya
# di server staging — jangan commit ke repository.
# ============================================================

# ── Domain publik (tanpa https://) ────────────────────────
# Digunakan oleh Caddy sebagai server_name dan untuk
# permintaan sertifikat TLS otomatis via ACME/Let's Encrypt.
APP_DOMAIN=staging.example.com

# ── PostgreSQL ────────────────────────────────────────────
# Ketiga variabel ini wajib diisi; Compose akan berhenti
# dengan pesan error jika salah satu kosong.
POSTGRES_USER=konkit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=konkit

# ── Google Drive OAuth (hanya jika STORAGE_BACKEND=gdrive) ─
# Isi path absolut pada host ke file token OAuth yang
# dihasilkan oleh: go run ./cmd/gdrive-oauth-setup
# Nilai ini digunakan oleh docker-compose.gdrive.yml. Jika sengaja
# memakai storage lokal, file override GDrive tidak perlu digunakan.
GDRIVE_OAUTH_TOKEN_HOST_PATH=/absolute/path/to/gdrive-oauth-token.json
