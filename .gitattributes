# Normalize line endings for all text files on checkout.
* text=auto

# Source files — always LF in the repository.
*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.env*    text eol=lf
Makefile  text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — never modify.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary
*.xlsx    binary
*.exe     binary
*.zip     binary
